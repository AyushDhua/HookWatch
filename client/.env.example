# API Base URL.
# This is used to make API calls to the HookWatch backend server.
# In development, set it to the backend server URL (e.g. http://localhost:5000).
# In production, set it to your public API URL (e.g. https://hookwatch-api.onrender.com).
VITE_API_BASE_URL=http://localhost:5000

# Webhook Receiver Base URL.
# This is used to construct the absolute public webhook URL shown in the dashboard.
# In development, set it to the backend server URL (e.g. http://localhost:5000).
# In production, set it to your public API URL (e.g. https://hookwatch-api.onrender.com).
VITE_WEBHOOK_BASE_URL=http://localhost:5000
